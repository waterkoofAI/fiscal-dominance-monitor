# Everything below is OPTIONAL. The project works with no keys at all:
# FRED is read through the keyless fredgraph.csv endpoint, Yahoo and CoinGecko
# need no auth. Set these only if you hit rate limits or want better errors.

# https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# HTTP proxy for the collector, e.g. 127.0.0.1:10808 if you run one locally.
FDM_PROXY=
